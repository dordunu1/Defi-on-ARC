{
  "name": "custom-dex-contracts",
  "version": "1.0.0",
  "description": "Custom DEX contracts for Arc Testnet",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:arc": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:arc:tokens": "cross-env DEPLOY_TYPE=tokens hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:arc:factory": "cross-env DEPLOY_TYPE=factory hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:arc:all": "cross-env DEPLOY_TYPE=all hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:arc:retry": "ts-node scripts/deployWithRetry.ts",
    "deploy:arc:router": "hardhat run scripts/deployRouter.ts --network arcTestnet",
    "deploy:staking": "hardhat run scripts/deployStaking.ts --network arcTestnet",
    "add-usdc-pools": "hardhat run scripts/addUSDCpoolsToStaking.ts --network arcTestnet",
    "transfer-staking-ownership": "hardhat run scripts/transferStakingOwnership.ts --network arcTestnet",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "add-liquidity": "hardhat run scripts/addInitialLiquidity.ts --network arcTestnet",
    "test": "hardhat test",
    "clean": "hardhat clean"
  },
  "keywords": [
    "dex",
    "uniswap",
    "defi",
    "arc-testnet"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "react-router-dom": "^7.9.6"
  }
}
