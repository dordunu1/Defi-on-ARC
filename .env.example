# Alchemy API Key (for RPC)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Supabase Configuration (for indexer and frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Maintenance Mode: Set to "true" to show maintenance page, "false" or omit to go live
VITE_MAINTENANCE_MODE=false

# Bridge Maintenance Mode: Set to "true" to disable bridge feature, "false" or omit to enable
VITE_BRIDGE_MAINTENANCE_MODE=false

# Discord Configuration
VITE_DISCORD_SERVER_ID=your_discord_server_id_here
VITE_DISCORD_INVITE_LINK=https://discord.com/invite/your_invite_code_here

# Indexer WebSocket URL (for indexer.ts)
WSS_URL=wss://rpc.testnet.arc.network

# Supabase for Indexer (Node.js environment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Staking Rewards Contract Address (for indexer)
STAKING_REWARDS_ADDRESS=0x814b2b51c0A2d1Ba932A2D16e73de1C3cABc3BC1

